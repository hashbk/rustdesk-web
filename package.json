{
  "name": "rustdesk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based remote control client for the RustDesk ecosystem",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.bridge.config.ts",
    "build:app": "vite build",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "build:web": "bash scripts/build-web.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fzstd": "^0.1.1",
    "protobufjs": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
