# Console (rustdesk-console) backend base URL, used by the dev proxy and the
# runtime API client. In production set this to your console deployment.
VITE_CONSOLE_API=http://localhost:3000

# Standalone fallback rendezvous configuration, used when the console
# /api/settings/server endpoint is unavailable (e.g. local testing).
# Leave empty to require the console endpoint.
VITE_FALLBACK_RENDEZVOUS_HOST=
VITE_FALLBACK_KEY=
VITE_FALLBACK_RELAY_HOST=
VITE_FALLBACK_USE_WSS=true